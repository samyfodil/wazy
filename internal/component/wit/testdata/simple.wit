package example:test@0.1.0;

interface math {
  type big-int = list<u8>;
  record point { x: s32, y: s32 }
  variant color { red, green, blue, custom(string) }
  enum direction { north, south, east, west }
  flags permissions { read, write, execute }

  add: func(a: u32, b: u32) -> u32;
  process: func(p: point) -> result<color, string>;
}

world command {
  export run: func() -> result<_, string>;
}
