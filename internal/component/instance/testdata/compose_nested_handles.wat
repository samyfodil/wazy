;; Resource handles nested inside composites, crossing guest-to-guest imports.
;;
;; $P defines resource r (its rep is the u32 it was made from; its destructor
;; counts drops) and exports funcs taking and returning handles inside a
;; record, an option<result<..>> and lists. $Q imports r from $P and takes a
;; list of borrows of it -- a resource $Q does not own, so the borrows are
;; minted in $Q's own table, scoped to the call. $A imports both and runs the
;; cases, each export returning a checksum (see compose_nested_handles_test.go).
(component
  (component $P
    (core module $dtorm
      (global $count (mut i32) (i32.const 0))
      (func (export "dtor") (param i32)
        (global.set $count (i32.add (global.get $count) (i32.const 1))))
      (func (export "count") (result i32) (global.get $count)))
    (core instance $dtormi (instantiate $dtorm))
    (type $r (resource (rep i32) (dtor (core func $dtormi "dtor"))))
    (core func $new (canon resource.new $r))
    (core func $rep (canon resource.rep $r))
    (core func $drop (canon resource.drop $r))

    (core module $main
      (import "res" "new" (func $new (param i32) (result i32)))
      (import "res" "rep" (func $rep (param i32) (result i32)))
      (import "res" "drop" (func $drop (param i32)))
      (memory (export "mem") 1)
      (global $bump (mut i32) (i32.const 4096))
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (local $p i32)
        (local.set $p (i32.and (i32.add (global.get $bump) (i32.const 7)) (i32.const -8)))
        (global.set $bump (i32.add (local.get $p) (local.get 3)))
        (local.get $p))
      (func (export "make") (param $v i32) (result i32) (call $new (local.get $v)))
      ;; A borrow of P's own resource arrives as its rep.
      (func (export "value") (param $rep i32) (result i32) (local.get $rep))
      (func $take (param $h i32) (result i32)
        (local $v i32)
        (local.set $v (call $rep (local.get $h)))
        (call $drop (local.get $h))
        (local.get $v))
      (func (export "take-rec") (param $a i32) (param $h i32) (result i32)
        (i32.add (local.get $a) (call $take (local.get $h))))
      (func (export "take-deep") (param $opt i32) (param $res i32) (param $p i32) (result i32)
        (if (result i32) (i32.eqz (local.get $opt))
          (then (i32.const 0))
          (else (if (result i32) (i32.eqz (local.get $res))
            (then (call $take (local.get $p)))
            (else (local.get $p))))))
      (func (export "take-list") (param $ptr i32) (param $len i32) (result i32)
        (local $s i32) (local $i i32)
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $s (i32.add (local.get $s)
            (call $take (i32.load (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 2)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $s))
      (func (export "peek") (param $b i32) (param $ptr i32) (param $len i32) (result i32)
        (local $s i32) (local $i i32)
        (local.set $s (local.get $b))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $s (i32.add (local.get $s)
            (i32.load (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $s))
      ;; Results too wide to return flat go through a return area.
      (func (export "make-rec") (param $v i32) (result i32)
        (i32.store (i32.const 64) (i32.add (local.get $v) (i32.const 1)))
        (i32.store (i32.const 68) (call $new (local.get $v)))
        (i32.const 64))
      (func (export "make-list") (param $v i32) (result i32)
        (i32.store (i32.const 128) (call $new (local.get $v)))
        (i32.store (i32.const 132) (call $new (i32.add (local.get $v) (i32.const 1))))
        (i32.store (i32.const 96) (i32.const 128))
        (i32.store (i32.const 100) (i32.const 2))
        (i32.const 96))
      (func (export "make-deep") (param $v i32) (result i32)
        (i32.store8 (i32.const 160) (i32.const 1))
        (i32.store8 (i32.const 164) (i32.const 0))
        (i32.store (i32.const 168) (call $new (local.get $v)))
        (i32.const 160))
      ;; A list holding a handle P never made.
      (func (export "make-bad") (result i32)
        (i32.store (i32.const 200) (i32.const 99))
        (i32.store (i32.const 192) (i32.const 200))
        (i32.store (i32.const 196) (i32.const 1))
        (i32.const 192)))
    (core instance $maini (instantiate $main
      (with "res" (instance
        (export "new" (func $new))
        (export "rep" (func $rep))
        (export "drop" (func $drop))))))

    (type $rec (record (field "a" u32) (field "h" (own $r))))
    (type $deep (option (result (own $r) (error u32))))
    (type $owns (list (own $r)))
    (type $peek (tuple (borrow $r) (list (borrow $r))))
    (func $make (param "v" u32) (result (own $r)) (canon lift (core func $maini "make")))
    (func $value (param "x" (borrow $r)) (result u32) (canon lift (core func $maini "value")))
    (func $take-rec (param "x" $rec) (result u32) (canon lift (core func $maini "take-rec")))
    (func $take-deep (param "x" $deep) (result u32) (canon lift (core func $maini "take-deep")))
    (func $take-list (param "x" $owns) (result u32)
      (canon lift (core func $maini "take-list") (memory (core memory $maini "mem")) (realloc (core func $maini "realloc"))))
    (func $peek (param "x" $peek) (result u32)
      (canon lift (core func $maini "peek") (memory (core memory $maini "mem")) (realloc (core func $maini "realloc"))))
    (func $make-rec (param "v" u32) (result $rec) (canon lift (core func $maini "make-rec") (memory (core memory $maini "mem"))))
    (func $make-list (param "v" u32) (result $owns) (canon lift (core func $maini "make-list") (memory (core memory $maini "mem"))))
    (func $make-deep (param "v" u32) (result $deep) (canon lift (core func $maini "make-deep") (memory (core memory $maini "mem"))))
    (func $make-bad (result $owns) (canon lift (core func $maini "make-bad") (memory (core memory $maini "mem"))))
    (func $count (result u32) (canon lift (core func $dtormi "count")))
    ;; The same three, typed async for A to lower async.
    (func $take-list-async async (param "x" $owns) (result u32)
      (canon lift (core func $maini "take-list") (memory (core memory $maini "mem")) (realloc (core func $maini "realloc"))))
    (func $make-rec-async async (param "v" u32) (result $rec) (canon lift (core func $maini "make-rec") (memory (core memory $maini "mem"))))
    (func $make-bad-async async (result $owns) (canon lift (core func $maini "make-bad") (memory (core memory $maini "mem"))))
    (instance $iface
      (export "r" (type $r))
      (export "rec" (type $rec))
      (export "make" (func $make))
      (export "value" (func $value))
      (export "take-rec" (func $take-rec))
      (export "take-deep" (func $take-deep))
      (export "take-list" (func $take-list))
      (export "peek" (func $peek))
      (export "make-rec" (func $make-rec))
      (export "make-list" (func $make-list))
      (export "make-deep" (func $make-deep))
      (export "make-bad" (func $make-bad))
      (export "count" (func $count))
      (export "take-list-async" (func $take-list-async))
      (export "make-rec-async" (func $make-rec-async))
      (export "make-bad-async" (func $make-bad-async)))
    (export "test:nest/p" (instance $iface)))

  (component $Q
    (import "test:nest/p" (instance $p
      (export "r" (type $r (sub resource)))
      (export "value" (func (param "x" (borrow $r)) (result u32)))))
    (alias export $p "r" (type $r))
    (alias export $p "value" (func $value))
    (core func $value' (canon lower (func $value)))
    (core func $drop' (canon resource.drop $r))
    (core module $main
      (import "p" "value" (func $value (param i32) (result i32)))
      (import "p" "drop" (func $drop (param i32)))
      (memory (export "mem") 1)
      (global $bump (mut i32) (i32.const 4096))
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (local $p i32)
        (local.set $p (i32.and (i32.add (global.get $bump) (i32.const 7)) (i32.const -8)))
        (global.set $bump (i32.add (local.get $p) (local.get 3)))
        (local.get $p))
      (func $sum (param $s i32) (param $ptr i32) (param $len i32) (param $drop i32) (result i32)
        (local $i i32) (local $h i32)
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $h (i32.load (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 2)))))
          (local.set $s (i32.add (local.get $s) (call $value (local.get $h))))
          (if (local.get $drop) (then (call $drop (local.get $h))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $s))
      (func (export "peek2") (param $s i32) (param $ptr i32) (param $len i32) (result i32)
        (call $sum (local.get $s) (local.get $ptr) (local.get $len) (i32.const 1)))
      ;; Returns still holding its borrows, which the call refuses.
      (func (export "leak2") (param $s i32) (param $ptr i32) (param $len i32) (result i32)
        (call $sum (local.get $s) (local.get $ptr) (local.get $len) (i32.const 0))))
    (core instance $maini (instantiate $main
      (with "p" (instance
        (export "value" (func $value'))
        (export "drop" (func $drop'))))))
    (type $peek2 (tuple u32 (list (borrow $r))))
    (func $peek2 (param "x" $peek2) (result u32)
      (canon lift (core func $maini "peek2") (memory (core memory $maini "mem")) (realloc (core func $maini "realloc"))))
    (func $leak2 (param "x" $peek2) (result u32)
      (canon lift (core func $maini "leak2") (memory (core memory $maini "mem")) (realloc (core func $maini "realloc"))))
    (instance $iface
      (export "peek2" (func $peek2))
      (export "leak2" (func $leak2)))
    (export "test:nest/q" (instance $iface)))

  (component $A
    (import "test:nest/p" (instance $p
      (export "r" (type $r (sub resource)))
      (type $rec' (record (field "a" u32) (field "h" (own $r))))
      (export "rec" (type $rec (eq $rec')))
      (type $deep (option (result (own $r) (error u32))))
      (type $owns (list (own $r)))
      (type $peek (tuple (borrow $r) (list (borrow $r))))
      (export "make" (func (param "v" u32) (result (own $r))))
      (export "value" (func (param "x" (borrow $r)) (result u32)))
      (export "take-rec" (func (param "x" $rec) (result u32)))
      (export "take-deep" (func (param "x" $deep) (result u32)))
      (export "take-list" (func (param "x" $owns) (result u32)))
      (export "peek" (func (param "x" $peek) (result u32)))
      (export "make-rec" (func (param "v" u32) (result $rec)))
      (export "make-list" (func (param "v" u32) (result $owns)))
      (export "make-deep" (func (param "v" u32) (result $deep)))
      (export "make-bad" (func (result $owns)))
      (export "count" (func (result u32)))
      (export "take-list-async" (func async (param "x" $owns) (result u32)))
      (export "make-rec-async" (func async (param "v" u32) (result $rec)))
      (export "make-bad-async" (func async (result $owns)))))
    (alias export $p "r" (type $r))
    (import "test:nest/q" (instance $q
      (type $peek2 (tuple u32 (list (borrow $r))))
      (export "peek2" (func (param "x" $peek2) (result u32)))
      (export "leak2" (func (param "x" $peek2) (result u32)))))

    (core module $Mem
      (memory (export "mem") 1)
      (global $bump (mut i32) (i32.const 4096))
      (func (export "realloc") (param i32 i32 i32 i32) (result i32)
        (local $p i32)
        (local.set $p (i32.and (i32.add (global.get $bump) (i32.const 7)) (i32.const -8)))
        (global.set $bump (i32.add (local.get $p) (local.get 3)))
        (local.get $p)))
    (core instance $m (instantiate $Mem))

    (alias export $p "make" (func $make))
    (alias export $p "value" (func $value))
    (alias export $p "take-rec" (func $take-rec))
    (alias export $p "take-deep" (func $take-deep))
    (alias export $p "take-list" (func $take-list))
    (alias export $p "peek" (func $peek))
    (alias export $p "make-rec" (func $make-rec))
    (alias export $p "make-list" (func $make-list))
    (alias export $p "make-deep" (func $make-deep))
    (alias export $p "make-bad" (func $make-bad))
    (alias export $p "count" (func $count))
    (alias export $q "peek2" (func $peek2))
    (alias export $q "leak2" (func $leak2))
    (core func $make' (canon lower (func $make)))
    (core func $value' (canon lower (func $value)))
    (core func $take-rec' (canon lower (func $take-rec)))
    (core func $take-deep' (canon lower (func $take-deep)))
    (core func $take-list' (canon lower (func $take-list) (memory (core memory $m "mem"))))
    (core func $peek' (canon lower (func $peek) (memory (core memory $m "mem"))))
    (core func $make-rec' (canon lower (func $make-rec) (memory (core memory $m "mem"))))
    (core func $make-list' (canon lower (func $make-list) (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
    (core func $make-deep' (canon lower (func $make-deep) (memory (core memory $m "mem"))))
    (core func $make-bad' (canon lower (func $make-bad) (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
    (core func $count' (canon lower (func $count)))
    (core func $peek2' (canon lower (func $peek2) (memory (core memory $m "mem"))))
    (core func $leak2' (canon lower (func $leak2) (memory (core memory $m "mem"))))
    (alias export $p "take-list-async" (func $take-list-a))
    (alias export $p "make-rec-async" (func $make-rec-a))
    (alias export $p "make-bad-async" (func $make-bad-a))
    (core func $take-list-async (canon lower (func $take-list-a) async (memory (core memory $m "mem"))))
    (core func $make-rec-async (canon lower (func $make-rec-a) async (memory (core memory $m "mem"))))
    (core func $make-bad-async (canon lower (func $make-bad-a) async (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
    (core func $drop (canon resource.drop $r))

    (core module $main
      (import "m" "mem" (memory 1))
      (import "p" "make" (func $make (param i32) (result i32)))
      (import "p" "value" (func $value (param i32) (result i32)))
      (import "p" "take-rec" (func $take-rec (param i32 i32) (result i32)))
      (import "p" "take-deep" (func $take-deep (param i32 i32 i32) (result i32)))
      (import "p" "take-list" (func $take-list (param i32 i32) (result i32)))
      (import "p" "peek" (func $peek (param i32 i32 i32) (result i32)))
      (import "p" "make-rec" (func $make-rec (param i32 i32)))
      (import "p" "make-list" (func $make-list (param i32 i32)))
      (import "p" "make-deep" (func $make-deep (param i32 i32)))
      (import "p" "make-bad" (func $make-bad (param i32)))
      (import "p" "count" (func $count (result i32)))
      (import "p" "drop" (func $drop (param i32)))
      (import "p" "take-list-async" (func $take-list-async (param i32 i32 i32) (result i32)))
      (import "p" "make-rec-async" (func $make-rec-async (param i32 i32) (result i32)))
      (import "p" "make-bad-async" (func $make-bad-async (param i32) (result i32)))
      (import "q" "peek2" (func $peek2 (param i32 i32 i32) (result i32)))
      (import "q" "leak2" (func $leak2 (param i32 i32 i32) (result i32)))

      ;; own handles into P: a record field, option<result<own>>'s payload,
      ;; list elements. (11 + 20 + 70) * 100 + 5 drops.
      (func (export "own-args") (result i32)
        (local $h1 i32) (local $h2 i32) (local $h5 i32) (local $s i32)
        (local.set $h1 (call $make (i32.const 10)))
        (local.set $h2 (call $make (i32.const 20)))
        (i32.store (i32.const 0x100) (call $make (i32.const 30)))
        (i32.store (i32.const 0x104) (call $make (i32.const 40)))
        (local.set $h5 (call $make (i32.const 50)))
        (local.set $s (call $take-rec (i32.const 1) (local.get $h1)))
        (local.set $s (i32.add (local.get $s) (call $take-deep (i32.const 1) (i32.const 0) (local.get $h2))))
        (local.set $s (i32.add (local.get $s) (call $take-list (i32.const 0x100) (i32.const 2))))
        (call $drop (local.get $h5))
        (i32.add (i32.mul (local.get $s) (i32.const 100)) (call $count)))

      ;; own handles out of P, the same three ways. (15 + 7 + 9) * 100 + 4.
      (func (export "own-results") (result i32)
        (local $h i32) (local $l i32) (local $s i32)
        (call $make-rec (i32.const 7) (i32.const 0x200))
        (local.set $h (i32.load (i32.const 0x204)))
        (local.set $s (i32.add (i32.load (i32.const 0x200)) (call $value (local.get $h))))
        (call $drop (local.get $h))
        (call $make-list (i32.const 3) (i32.const 0x210))
        (if (i32.ne (i32.load (i32.const 0x214)) (i32.const 2)) (then unreachable))
        (local.set $l (i32.load (i32.const 0x210)))
        (local.set $s (i32.add (local.get $s) (call $value (i32.load (local.get $l)))))
        (local.set $s (i32.add (local.get $s) (call $value (i32.load offset=4 (local.get $l)))))
        (call $drop (i32.load (local.get $l)))
        (call $drop (i32.load offset=4 (local.get $l)))
        (call $make-deep (i32.const 9) (i32.const 0x220))
        (if (i32.ne (i32.load8_u (i32.const 0x220)) (i32.const 1)) (then unreachable))
        (if (i32.ne (i32.load8_u (i32.const 0x224)) (i32.const 0)) (then unreachable))
        (local.set $h (i32.load (i32.const 0x228)))
        (local.set $s (i32.add (local.get $s) (call $value (local.get $h))))
        (call $drop (local.get $h))
        (i32.add (i32.mul (local.get $s) (i32.const 100)) (call $count)))

      ;; borrows into their owner, a tuple element and list elements, which
      ;; leave A's handles in place. (18 + 5) * 100 + 3.
      (func (export "borrow-owner") (result i32)
        (local $h1 i32) (local $s i32)
        (local.set $h1 (call $make (i32.const 5)))
        (i32.store (i32.const 0x300) (call $make (i32.const 6)))
        (i32.store (i32.const 0x304) (call $make (i32.const 7)))
        (local.set $s (call $peek (local.get $h1) (i32.const 0x300) (i32.const 2)))
        (local.set $s (i32.add (local.get $s) (call $value (local.get $h1))))
        (call $drop (local.get $h1))
        (call $drop (i32.load (i32.const 0x300)))
        (call $drop (i32.load (i32.const 0x304)))
        (i32.add (i32.mul (local.get $s) (i32.const 100)) (call $count)))

      ;; borrows into Q, which does not own r. (100 + 11 + 12 + 11) * 100 + 2.
      (func (export "borrow-other") (result i32)
        (local $s i32)
        (i32.store (i32.const 0x400) (call $make (i32.const 11)))
        (i32.store (i32.const 0x404) (call $make (i32.const 12)))
        (local.set $s (call $peek2 (i32.const 100) (i32.const 0x400) (i32.const 2)))
        (local.set $s (i32.add (local.get $s) (call $value (i32.load (i32.const 0x400)))))
        (call $drop (i32.load (i32.const 0x400)))
        (call $drop (i32.load (i32.const 0x404)))
        (i32.add (i32.mul (local.get $s) (i32.const 100)) (call $count)))

      ;; The same crossings through async lowers: (3 + 5 + 4) * 1000 +
      ;; (RETURNED + RETURNED) * 10 + 3.
      (func (export "async") (result i32)
        (local $st i32) (local $h i32) (local $s i32)
        (i32.store (i32.const 0x500) (call $make (i32.const 1)))
        (i32.store (i32.const 0x504) (call $make (i32.const 2)))
        (local.set $st (call $take-list-async (i32.const 0x500) (i32.const 2) (i32.const 0x510)))
        (local.set $st (i32.add (local.get $st) (call $make-rec-async (i32.const 4) (i32.const 0x520))))
        (local.set $h (i32.load (i32.const 0x524)))
        (local.set $s (i32.add (i32.load (i32.const 0x510)) (i32.load (i32.const 0x520))))
        (local.set $s (i32.add (local.get $s) (call $value (local.get $h))))
        (call $drop (local.get $h))
        (i32.add (i32.add (i32.mul (local.get $s) (i32.const 1000)) (i32.mul (local.get $st) (i32.const 10)))
          (call $count)))

      (func (export "bad-arg") (result i32)
        (call $take-rec (i32.const 1) (i32.const 999)))
      (func (export "bad-result") (result i32)
        (call $make-bad (i32.const 0x600))
        (i32.const 0))
      (func (export "leak") (result i32)
        (i32.store (i32.const 0x800) (call $make (i32.const 1)))
        (call $leak2 (i32.const 0) (i32.const 0x800) (i32.const 1)))
      (func (export "bad-arg-async") (result i32)
        (i32.store (i32.const 0x700) (i32.const 999))
