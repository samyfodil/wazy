;; memclr_xmm15.wat -- a large constant zero memory.fill with sixteen v128
;; values live across it, so the register allocator has one in every vector
;; register (xmm15 included) at the call. Go's amd64 ABI reserves X15 as a zero
;; register and runtime.memclrNoHeapPointers' SSE path reads it as one, so a
;; nonzero X15 makes the "clear" write garbage. Only reproduces without AVX2.
;;
;; Rebuild with: wat2wasm testdata/memclr_xmm15.wat -o testdata/memclr_xmm15.wasm
(module
  (memory (export "mem") 1)
  (func (export "run") (result v128)
    (local $v0 v128)
    (local $v1 v128)
    (local $v2 v128)
    (local $v3 v128)
    (local $v4 v128)
    (local $v5 v128)
    (local $v6 v128)
    (local $v7 v128)
    (local $v8 v128)
    (local $v9 v128)
    (local $v10 v128)
    (local $v11 v128)
    (local $v12 v128)
    (local $v13 v128)
    (local $v14 v128)
    (local $v15 v128)
    (local.set $v0 (v128.const i32x4 0x11111111 0x22222222 0x33333333 0x44444444))
    (local.set $v1 (v128.const i32x4 0x22222222 0x44444444 0x66666666 0x88888888))
    (local.set $v2 (v128.const i32x4 0x33333333 0x66666666 0x99999999 0xcccccccc))
    (local.set $v3 (v128.const i32x4 0x44444444 0x88888888 0xcccccccc 0x11111110))
    (local.set $v4 (v128.const i32x4 0x55555555 0xaaaaaaaa 0xffffffff 0x55555554))
    (local.set $v5 (v128.const i32x4 0x66666666 0xcccccccc 0x33333332 0x99999998))
    (local.set $v6 (v128.const i32x4 0x77777777 0xeeeeeeee 0x66666665 0xdddddddc))
    (local.set $v7 (v128.const i32x4 0x88888888 0x11111110 0x99999998 0x22222220))
    (local.set $v8 (v128.const i32x4 0x99999999 0x33333332 0xcccccccb 0x66666664))
    (local.set $v9 (v128.const i32x4 0xaaaaaaaa 0x55555554 0xfffffffe 0xaaaaaaa8))
    (local.set $v10 (v128.const i32x4 0xbbbbbbbb 0x77777776 0x33333331 0xeeeeeeec))
    (local.set $v11 (v128.const i32x4 0xcccccccc 0x99999998 0x66666664 0x33333330))
    (local.set $v12 (v128.const i32x4 0xdddddddd 0xbbbbbbba 0x99999997 0x77777774))
    (local.set $v13 (v128.const i32x4 0xeeeeeeee 0xdddddddc 0xccccccca 0xbbbbbbb8))
    (local.set $v14 (v128.const i32x4 0xffffffff 0xfffffffe 0xfffffffd 0xfffffffc))
    (local.set $v15 (v128.const i32x4 0x11111110 0x22222220 0x33333330 0x44444440))
    ;; The fill sits between the definitions and the uses, so every local is
    ;; live across the memclr call.
    (memory.fill (i32.const 0) (i32.const 0) (i32.const 1024))
    (i8x16.add (local.get $v0) (local.get $v1))
    (i8x16.add (local.get $v2))
    (i8x16.add (local.get $v3))
    (i8x16.add (local.get $v4))
    (i8x16.add (local.get $v5))
    (i8x16.add (local.get $v6))
    (i8x16.add (local.get $v7))
    (i8x16.add (local.get $v8))
    (i8x16.add (local.get $v9))
    (i8x16.add (local.get $v10))
    (i8x16.add (local.get $v11))
    (i8x16.add (local.get $v12))
    (i8x16.add (local.get $v13))
    (i8x16.add (local.get $v14))
    (i8x16.add (local.get $v15))
  ))
