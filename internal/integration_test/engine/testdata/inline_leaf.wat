;; Small straight-line functions the compiler lowers in place of their calls, for TestInlineLeaf.
(module
  (memory 1)
  (global $g (mut i32) (i32.const 7))
  (func $load (param i32) (result i32)
    (i32.load offset=4 (local.get 0)))
  (func $mix (param i32 i64) (result i64)
    (local i64)
    (local.set 2 (i64.extend_i32_u (i32.add (local.get 0) (global.get $g))))
    (i64.store (local.get 0) (i64.mul (local.get 1) (local.get 2)))
    (select (local.get 2) (local.get 1) (local.get 0)))
  (func (export "load_via_leaf") (param i32) (result i32)
    (i32.add (call $load (local.get 0)) (i32.const 1)))
  (func (export "mix_via_leaf") (param i32 i64) (result i64)
    (call $mix (local.get 0) (local.get 1)))
  ;; The leaf's access is fine; the caller's own access after it traps.
  (func (export "trap_after_leaf") (param i32) (result i32)
    (drop (call $load (i32.const 0)))
    (i32.load (local.get 0)))
  ;; 300 functions put $far_load past index 255, so its exit code needs more than 16 bits.
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func) (func)
  (func $far_load (param i32) (result i32)
    (i32.load (local.get 0)))
  (func (export "load_via_far_leaf") (param i32) (result i32)
    (call $far_load (local.get 0)))
)
