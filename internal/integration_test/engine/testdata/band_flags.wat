;; Comparisons of an and with zero, which arm64 makes a tst: see band_flags_test.go.
(module
  (func (export "gtu") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.gt_u (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "geu") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.ge_u (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "ltu") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.lt_u (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "leu") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.le_u (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "gts") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.gt_s (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "les") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.le_s (i32.and (local.get $x) (local.get $m)) (i32.const 0))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "zgtu") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.lt_u (i32.const 0) (i32.and (local.get $x) (local.get $m)))) (return (i32.const 0)))
    (i32.const 1))
  ;; The prime-implicants shape: not (x and m) and not (y and not x), to the outer block.
  (func (export "subset") (param $x i32) (param $m i32) (result i32)
    (local $y i32)
    (local.set $y (i32.xor (local.get $m) (i32.const 0x0f0f)))
    (block $out
      (block $next
        (br_if $next (i32.and (local.get $x) (local.get $m)))
        (br_if $out (i32.eqz (i32.and (local.get $y) (i32.xor (local.get $x) (i32.const -1))))))
      (return (i32.const 7)))
    (i32.const 9))
  ;; Branches on an and itself: a register, an immediate that wraps round, and an if, which branches on
  ;; its being zero, with an arm no select takes.
  (func (export "rawand") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.and (local.get $x) (local.get $m))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "rawimm") (param $x i32) (param $m i32) (result i32)
    (block $b (br_if $b (i32.and (local.get $x) (i32.const -5))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "ifand") (param $x i32) (param $m i32) (result i32)
    (if (result i32) (i32.and (local.get $x) (i32.const 0x80000003))
      (then (i32.div_u (local.get $m) (i32.const 3)))
      (else (i32.mul (local.get $m) (local.get $x)))))
)
