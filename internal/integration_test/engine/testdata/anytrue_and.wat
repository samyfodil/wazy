;; v128.any_true of a v128.and, which the compiler tests with one ptest, as a value and as a branch
;; condition both ways, and once with the and used again so that it must still be computed.
(module
  (func $v (param i64 i64 i64 i64) (result v128 v128)
    (i64x2.replace_lane 1 (i64x2.splat (local.get 0)) (local.get 1))
    (i64x2.replace_lane 1 (i64x2.splat (local.get 2)) (local.get 3)))
  (func (export "value") (param i64 i64 i64 i64) (result i32)
    (call $v (local.get 0) (local.get 1) (local.get 2) (local.get 3))
    (v128.and)
    (v128.any_true))
  (func (export "branch") (param i64 i64 i64 i64) (result i32)
    (call $v (local.get 0) (local.get 1) (local.get 2) (local.get 3))
    (v128.and)
    (v128.any_true)
    (if (result i32) (then (i32.const 7)) (else (i32.const 9))))
  (func (export "branch_not") (param i64 i64 i64 i64) (result i32)
    (call $v (local.get 0) (local.get 1) (local.get 2) (local.get 3))
    (v128.and)
    (v128.any_true)
    (i32.eqz)
    (if (result i32) (then (i32.const 7)) (else (i32.const 9))))
  (func (export "shared") (param i64 i64 i64 i64) (result i32)
    (local v128)
    (call $v (local.get 0) (local.get 1) (local.get 2) (local.get 3))
    (v128.and)
    (local.tee 4)
    (v128.any_true)
    (i32.mul (i32.const 1000))
    (i32.add (i32.wrap_i64 (i64x2.extract_lane 1 (local.get 4))))))
