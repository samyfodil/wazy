    (call $grow)
    (i32.load (local.get $v)))
  (func (export "wrap") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.wrap_i64 (i64.const -8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "trunc_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.trunc_f64_s (f64.const -8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "trunc_sat_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.trunc_sat_f32_s (f32.const -8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "trunc_u") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.trunc_f64_u (f64.const 4294967288))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "reinterpret") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.reinterpret_f32 (f32.reinterpret_i32 (i32.const -8)))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "select") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (select (i32.const -8) (i32.const 4) (local.get $p))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "global") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (global.get $neg)))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "call") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (call $neg)))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "param") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (call $id (i32.const -8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "call_indirect") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (call_indirect (type $v_i32) (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "block") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (block (result i32) (i32.const -8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "if") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (if (result i32) (local.get $p) (then (i32.const -8)) (else (i32.const -12)))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "loop_phi") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (local.set $v (i32.const 0)) (loop $l (local.set $v (i32.sub (local.get $v) (i32.const 4))) (br_if $l (i32.ne (local.get $v) (i32.const -8)))) (local.get $v)))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "extract") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32x4.extract_lane 1 (i32x4.splat (i32.const -8)))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "extract8_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i8x16.extract_lane_s 0 (i8x16.splat (i32.const -8)))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "extract16_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i16x8.extract_lane_s 0 (i16x8.splat (i32.const -8)))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "atomic_load") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.atomic.store (i32.const 0) (i32.const -8)) (i32.atomic.load (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "atomic_rmw") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.atomic.store (i32.const 0) (i32.const -8)) (i32.atomic.rmw.add (i32.const 0) (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "cmpxchg") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.atomic.store (i32.const 0) (i32.const -8)) (i32.atomic.rmw.cmpxchg (i32.const 0) (i32.const 1) (i32.const 2))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "host_call") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (call $host_neg))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
)
