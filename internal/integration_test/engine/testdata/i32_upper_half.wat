;; Negative i32 values from every kind of producer, used as addresses in a 4 GiB memory, for
;; TestI32UpperHalf. Each is accessed again after a call, when the compiler rebuilds the address
;; from the bound the first access checked; that access must still use the value's 32 bits only.
(module
  (type $v_i32 (func (result i32)))
  (import "env" "neg" (func $host_neg (result i32)))
  (memory 65536)
  (global $neg i32 (i32.const -8))
  (table 1 funcref)
  (elem (i32.const 0) $neg)
  (func $grow (drop (memory.grow (i32.const 0))))
  (func $neg (type $v_i32) (i32.const -8))
  (func $id (param i32) (result i32) (local.get 0))
  (func (export "load8_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.store8 (i32.const 0) (i32.const 0xf8)) (i32.load8_s (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "load16_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.store16 (i32.const 0) (i32.const 0xfff8)) (i32.load16_s (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "load") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.store (i32.const 0) (i32.const -8)) (i32.load (i32.const 0))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "const") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.const -8)))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "add") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.add (local.get $p) (i32.const -16))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "sub") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.sub (i32.const 0) (i32.const 8))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "mul") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.mul (local.get $p) (i32.const -1))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "shl") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.shl (i32.const -1) (i32.const 3))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "shr_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.shr_s (i32.const -16) (i32.const 1))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "rotl") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.rotl (i32.const 0xfffffffe) (i32.const 2))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "xor") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.xor (local.get $p) (i32.const -1))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "div_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.div_s (i32.const -16) (i32.const 2))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "rem_s") (param $p i32) (result i32)
    (local $v i32)
    (local.set $v (block (result i32) (i32.add (i32.rem_s (i32.const -7) (i32.const 4)) (i32.const -5))))
    (i32.store (local.get $v) (i32.const 0x5a5a5a5a))
    (call $grow)
    (i32.load (local.get $v)))
  (func (export "extend8_s") (param $p i32) (result i32)
    (local $v i32)
