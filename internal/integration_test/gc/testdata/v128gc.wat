(module
  (type $s (struct (field i32) (field (mut v128)) (field i64)))
  (type $a (array (mut v128)))

  (func (export "struct_roundtrip") (param i64 i64) (result i64 i64)
    (local $r (ref $s))
    (local.set $r (struct.new_default $s))
    (struct.set $s 1 (local.get $r)
      (i64x2.replace_lane 1 (i64x2.splat (local.get 0)) (local.get 1)))
    (i64x2.extract_lane 0 (struct.get $s 1 (local.get $r)))
    (i64x2.extract_lane 1 (struct.get $s 1 (local.get $r)))
  )

  (func (export "struct_neighbours") (result i32 i64)
    (local $r (ref $s))
    (local.set $r (struct.new $s (i32.const 7) (v128.const i64x2 1 2) (i64.const 9)))
    (struct.get $s 0 (local.get $r))
    (struct.get $s 2 (local.get $r))
  )

  (func (export "array_roundtrip") (param i32 i64) (result i64 i64 i32)
    (local $r (ref $a))
    (local.set $r (array.new_default $a (i32.const 4)))
    (array.set $a (local.get $r) (local.get 0) (i64x2.splat (local.get 1)))
    (i64x2.extract_lane 0 (array.get $a (local.get $r) (local.get 0)))
    (i64x2.extract_lane 1 (array.get $a (local.get $r) (local.get 0)))
    (array.len (local.get $r))
  )

  (func (export "array_new_fill_copy") (result i64 i64 i64)
    (local $r (ref $a))
    (local.set $r (array.new $a (v128.const i64x2 5 6) (i32.const 3)))
    (array.fill $a (local.get $r) (i32.const 1) (v128.const i64x2 8 9) (i32.const 2))
    (array.copy $a $a (local.get $r) (i32.const 0) (local.get $r) (i32.const 2) (i32.const 1))
    (i64x2.extract_lane 0 (array.get $a (local.get $r) (i32.const 0)))
    (i64x2.extract_lane 1 (array.get $a (local.get $r) (i32.const 1)))
    (i64x2.extract_lane 0 (array.get $a (local.get $r) (i32.const 2)))
  )

  (func (export "array_fixed") (result i64 i64)
    (local $r (ref $a))
    (local.set $r (array.new_fixed $a 2 (v128.const i64x2 11 12) (v128.const i64x2 13 14)))
    (i64x2.extract_lane 1 (array.get $a (local.get $r) (i32.const 0)))
    (i64x2.extract_lane 0 (array.get $a (local.get $r) (i32.const 1)))
  )
)
