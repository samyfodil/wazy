# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/wazy
build
dist

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Goland
.idea

# AssemblyScript
node_modules
package-lock.json

# codecov.io
/coverage.txt

.vagrant

zig-cache/
.zig-cache/
zig-out/

.DS_Store

# Ignore compiled stdlib test cases.
/internal/integration_test/stdlibs/testdata
/internal/integration_test/libsodium/testdata

# Fetched and generated by `make build.component_testdata`.
/component/wit/testdata/wit-parser/ui/
/component/wit/testdata/oracle/
/internal/component/binary/testdata/wast/component-model-max-value-size/
/internal/component/binary/testdata/wast/wasm-tools-max-value-size/
/internal/component/instance/testdata/wast/fixed_length_lists/
/internal/component/instance/testdata/wast/wasm-tools-fixed-length-lists/
/internal/component/instance/testdata/wast/cm-validation-instantiation/
/internal/component/instance/testdata/wast/cm-validation-resources/
/internal/component/instance/testdata/wast/wasm-tools-instantiate/
/internal/component/instance/testdata/wast/wasm-tools-virtualize/
/internal/component/instance/testdata/wast/wasmtime-nested/
/internal/component/instance/testdata/wast/wasmtime-restrictions/
/internal/component/abi/testdata/definitions.py

# Fetched by `make build.spectest`. The suites that are fetched whole are ignored by a .gitignore in
# their testdata/, which also keeps the directory their tests embed.
/internal/integration_test/spectest/v3-interaction/testdata/wasmtime-*

# Fetched by `make build.wasi_testdata`.
/internal/component/wit/testdata/random.wit
/internal/component/wit/testdata/streams.wit

# Fetched by `make build.guest_testdata`.
/imports/http_handler/nethttp/testdata/panic_on_handle_request.wasm

# Fetched by `make build.wasi_otel_wit`. Each guest's world.wit is ours.
/imports/wasi_otel/testdata/*/wit/*
!/imports/wasi_otel/testdata/*/wit/world.wit

# Netlify CLI local state
.netlify/
.gstack/
.claude/worktrees/

# Component example build artifacts (the .wasm beside the source is committed;
# the toolchain scratch that produced it is not).
examples/*/*/target/
examples/*/*/node_modules/
examples/*/*/.venv/
examples/*/*/__pycache__/
